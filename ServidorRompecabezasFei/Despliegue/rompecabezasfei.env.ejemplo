# Copia este archivo a /etc/rompecabezasfei/rompecabezasfei.env y pon tus valores.
#   sudo chmod 600 /etc/rompecabezasfei/rompecabezasfei.env
# NUNCA subas el archivo real al repositorio.

DOTNET_ENVIRONMENT=Production

# Contraseña del usuario "rompecabezasuser" de PostgreSQL
ROMPECABEZAS_BaseDatos__Contrasena=cambia_esta_contrasena

# Contraseña de aplicación de Gmail para enviar los códigos por correo
ROMPECABEZAS_Correo__Contrasena=contrasena_de_aplicacion

# Opcional: otra base de datos u otro puerto
#ROMPECABEZAS_ConnectionStrings__EntidadesRompecabezasFei=Host=localhost;Port=5432;Database=RompecabezasFEI;Username=rompecabezasuser
#ROMPECABEZAS_Servidor__Puerto=8089
