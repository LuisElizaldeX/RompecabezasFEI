<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de log4net. La ruta del archivo es relativa a la carpeta del servidor. -->
<log4net>
  <appender name="ArchivoRegistro" type="log4net.Appender.RollingFileAppender">
    <file value="Registros/RompecabezasFEIRegistro.log" />
    <encoding value="utf-8" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="yyyyMMdd" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date &gt; [%logger]{%method} &gt; %level:: %message%n" />
    </layout>
  </appender>
  <appender name="Consola" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %level [%logger] %message%n" />
    </layout>
  </appender>
  <root>
    <level value="INFO" />
    <appender-ref ref="ArchivoRegistro" />
    <appender-ref ref="Consola" />
  </root>
</log4net>
