<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    En .NET 8 este archivo se copia como Servidor.dll.config y solo se usa
    para las rutas de Registros/Registrador.cs. La configuración de WCF
    ahora está en Servidor.cs y la de la base de datos en Datos/appsettings*.json.
    Las rutas relativas se toman desde la carpeta del servidor.
  -->
  <appSettings>
    <add key="Registros" value="Registros/Registros.txt" />
  </appSettings>
</configuration>
