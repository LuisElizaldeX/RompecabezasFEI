<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>Servidor.Servidor</StartupObject>
    <!-- Mismo id de user secrets que usa Datos/ConfiguracionServidor.cs -->
    <UserSecretsId>6a4816e4-f4c8-41ff-9bbd-37bd6a3baf52</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- CoreWCF se monta sobre el servidor de ASP.NET Core (Kestrel) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CoreWCF.Primitives" />
    <PackageReference Include="CoreWCF.NetTcp" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Contratos\Contratos.csproj" />
    <ProjectReference Include="..\Datos\Datos.csproj" />
    <ProjectReference Include="..\Logica\Logica.csproj" />
    <ProjectReference Include="..\Registros\Registros.csproj" />
    <ProjectReference Include="..\Servicios\Servicios.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
